# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://mintax:mintax_dev@localhost:5432/mintax
DATABASE_URL_TEST=postgres://mintax:mintax_dev@localhost:5432/mintax_test
# 운영: require (TLS)
DATABASE_SSL=

# ── Security ────────────────────────────────────────────
# 민감필드 암호화 키 (AES-256-GCM, base64 32bytes). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MINTAX_DATA_KEY=
# blind index HMAC 키 (base64 32bytes) — DATA_KEY 와 다른 값
MINTAX_INDEX_KEY=
# 키 교체 시 이전 키 (선택): v1:base64,v2:base64
MINTAX_DATA_KEYS_PREVIOUS=
# 세션: 유휴 만료(분) / 절대 만료(시간)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# 운영에서는 true (Secure 쿠키)
COOKIE_SECURE=false
# 관리자 MFA 강제
MFA_REQUIRED_FOR_ADMIN=true

# ── Storage ─────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI Provider (선택) ───────────────────────────────────
# heuristic(기본, 로컬 규칙) | anthropic
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Integrations ───────────────────────────────────────
# 위멤버스 공식 API 권한이 있을 때만 (없으면 FILE_BASED 로 동작)
WEMEMBERS_API_BASE_URL=
WEMEMBERS_API_KEY=
# Desktop Bridge 인증 토큰 (Bridge 설정 화면에서 발급)
BRIDGE_SHARED_SECRET=

# ── Worker ─────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
